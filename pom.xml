<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.cardigan</groupId>
    <artifactId>cardigan</artifactId>
    <version>0.1.0-alpha3</version>
    <name>Cardigan</name>
    <description>Experimental Java HTTP framework optimized for Loom and io_uring</description>
    <url>https://github.com/phjeltman/cardigan</url>
    <inceptionYear>2026</inceptionYear>

    <scm>
        <connection>scm:git:https://github.com/phjeltman/cardigan.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/phjeltman/cardigan.git</developerConnection>
        <url>https://github.com/phjeltman/cardigan</url>
        <tag>v0.1.0-alpha3</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/phjeltman/cardigan/issues</url>
    </issueManagement>

    <developers>
        <developer>
            <name>Per Hjeltman</name>
            <email>perhje@gmail.com</email>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>Mozilla Public License 2.0</name>
            <url>https://www.mozilla.org/MPL/2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.11.0</junit.jupiter.version>
        <cardigan.test.groups></cardigan.test.groups>
        <cardigan.test.excludedGroups>integration,stress</cardigan.test.excludedGroups>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>THIRD_PARTY_NOTICES.md</include>
                    <include>LICENSES/Apache-2.0.txt</include>
                    <include>LICENSES/picohttpparser-MIT.txt</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Java compiler plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override">
                                <arg>--add-modules</arg>
                                <arg>jdk.incubator.vector</arg>
                                <arg>--enable-preview</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire test runner plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>
                        --enable-preview --enable-native-access=ALL-UNNAMED --add-opens java.base/java.lang=ALL-UNNAMED --add-modules jdk.incubator.vector -XX:MaxInlineSize=150 -XX:FreqInlineSize=600
                    </argLine>
                    <groups>${cardigan.test.groups}</groups>
                    <excludedGroups>${cardigan.test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>dev.cardigan</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>publication</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <release>26</release>
                            <additionalOptions>
                                <additionalOption>--add-modules</additionalOption>
                                <additionalOption>jdk.incubator.vector</additionalOption>
                            </additionalOptions>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-publication</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>integration-tests</id>
            <properties>
                <cardigan.test.excludedGroups>stress,advanced-tls</cardigan.test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>tls-tests</id>
            <properties>
                <cardigan.test.groups>tls</cardigan.test.groups>
                <cardigan.test.excludedGroups>advanced-tls</cardigan.test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>advanced-tls-tests</id>
            <properties>
                <cardigan.test.groups>advanced-tls</cardigan.test.groups>
                <cardigan.test.excludedGroups>__none__</cardigan.test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>stress-tests</id>
            <properties>
                <cardigan.test.groups>stress</cardigan.test.groups>
                <cardigan.test.excludedGroups>__none__</cardigan.test.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>all-tests</id>
            <properties>
                <cardigan.test.excludedGroups>__none__</cardigan.test.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
